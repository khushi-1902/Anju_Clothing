# Frontend environment variables — Vite loads these from /frontend/.env at startup.
# https://vitejs.dev/guide/env-and-mode.html#env-files
#
# NOTE: Vite exposes variables prefixed with `VITE_` to the browser client
# (import.meta.env.VITE_*). NEVER put secret keys (anything CLERK_SECRET_*) into
# VITE_ prefixed variables for the frontend bundle; they get shipped to users.
# Secret keys live in backend/.env (not this file) once the backend is wired.

# -----------------------------------------------------------------------------
# Clerk — client-side (public) key only. Put this in .env, not this example.
# Get it from: https://dashboard.clerk.com/ -> App "Anju Clothing" -> API Keys
#              -> Show publishable key (it's safe to ship to browsers).
# -----------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# App configuration
# -----------------------------------------------------------------------------
VITE_APP_NAME=Anju Clothing
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
VITE_WHATSAPP_NUMBER=919625923308
